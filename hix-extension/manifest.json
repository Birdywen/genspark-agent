{
  "manifest_version": 3,
  "name": "Hix Agent Bridge",
  "version": "1.0.0",
  "description": "将 Hix.ai 聊天窗口转变为 AI Agent 运行时 (SSE+WS)",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://hix.ai/*",
    "https://*.hix.ai/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hix.ai/*"],
      "js": ["sse-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://hix.ai/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel-enhancer.js"],
      "matches": ["https://hix.ai/*"]
    }
  ]
}
